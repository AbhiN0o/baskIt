# ---- Server ----
NODE_ENV=production
PORT=3000

# ---- Database (MongoDB Atlas connection string) ----
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/baskit?retryWrites=true&w=majority

# ---- Auth ----
# generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# ---- Frontend URL(s) allowed by CORS + used in verification emails ----
# no trailing slash; comma separate to allow several (e.g. production + local)
FRONTEND_URL=https://your-app.vercel.app

# ---- Cloudinary (image uploads) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Gemini (AI review summaries, product details, care guides) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ---- Email (seller verification) ----
EMAIL_FROM="Baskit <you@example.com>"
# Recommended on Render (HTTPS API, works on the free tier):
BREVO_API_KEY=
# Only used when BREVO_API_KEY is empty. NOTE: Render's free tier blocks SMTP ports 25/465/587.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
